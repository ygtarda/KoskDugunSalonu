# ==============================================================================
# Köşk Düğün Salonu - E-posta & Form Bildirim Yapılandırması
# ==============================================================================
# Form üzerinden gelen randevu & teklif taleplerinin e-posta olarak iletilmesi için
# aşağıdaki seçeneklerden birini .env.local dosyanıza tanımlayabilirsiniz:

# Ortak Alıcı E-postası (Taleplerin gideceği salon yönetim e-postası)
CONTACT_RECEIVER_EMAIL=iletisim@koskdugunsalonu.com

# Gönderici E-posta Adı (Resend / SendGrid / SMTP ortak kullanım)
EMAIL_FROM=Köşk Düğün Salonu <iletisim@koskdugunsalonu.com>

# ------------------------------------------------------------------------------
# SEÇENEK A: Resend API (Önerilen Modern Bulut Servisi - https://resend.com)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_123456789abcdef0123456789

# ------------------------------------------------------------------------------
# SEÇENEK B: SendGrid API (Kurumsal E-posta Servisi - https://sendgrid.com)
# ------------------------------------------------------------------------------
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# SEÇENEK C: Standart SMTP (Gmail, Kurumsal Hosting veya Yerel Mailpit)
# ------------------------------------------------------------------------------
# Yerel testler için Mailpit (localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Gmail veya Yandex Kurumsal SMTP Kullanımı:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bilgi@koskdugunsalonu.com
# SMTP_PASS=uygulama_sifresi_buraya
